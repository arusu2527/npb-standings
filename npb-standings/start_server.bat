@echo off
chcp 65001 > nul
title NPB 順位表・対戦表システム 起動スクリプト
cd /d "%~dp0"

echo ========================================================
echo   NPB 順位表・対戦表システム を起動しています...
echo ========================================================
echo.

echo [1/2] ブラウザでアプリケーションを開いています...
start "" "http://localhost:8080"

echo [2/2] アクセスカウンター対応サーバー (ポート 8080) を起動中...
echo.
echo ※ インターネット全体へ誰でも見れるように公開したい場合は、
echo    「start_public_server.bat」を実行してください。
echo.
echo ※ この黒い画面を閉じるとサーバーが停止します。
echo    使用中は最小化しておいてください。
echo.

python server.py

pause
